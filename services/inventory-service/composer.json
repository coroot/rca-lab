{
    "name": "rca-lab/inventory-service",
    "description": "Inventory service (PHP 8.3 FPM + PostgreSQL)",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "monolog/monolog": "3.10.0",
        "open-telemetry/api": "1.10.0",
        "open-telemetry/sdk": "1.15.0",
        "open-telemetry/exporter-otlp": "1.4.0",
        "open-telemetry/opentelemetry-auto-pdo": "0.5.0",
        "open-telemetry/opentelemetry-logger-monolog": "1.3.0",
        "php-http/guzzle7-adapter": "1.1.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
